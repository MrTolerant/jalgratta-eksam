      en: 'Who gives way at a normal roundabout if signs do not say otherwise?',
    },
    options: [
      { id: 'opt_1', text: { et: 'Ringile siseneja annab teed juba ringil sõitjatele.', ru: 'Въезжающий на круг уступает тем, кто уже на кольце.', en: 'The rider entering gives way to traffic already in the circle.' } },
      { id: 'opt_2', text: { et: 'Ringil olijad peatuvad alati.', ru: 'Те, кто на круге, всегда останавливаются.', en: 'Those already in the circle always stop.' } },
