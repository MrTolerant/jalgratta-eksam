        <path d="M250 102 L200 102" stroke="#f59e0b" strokeWidth="3" markerEnd="url(#bsR)" fill="none" />
        <BikeTop x={80} y={154} rot={90} you label={t(lang, 'Sina', 'Ты', 'You')} />
      </svg>
    </Frame>
  );
}

