    options: [
      { id: 'opt_1', text: { et: 'Annab bussile teed, et see saaks peatusest välja.', ru: 'Уступает автобусу, чтобы тот мог выехать с остановки.', en: 'Gives way so the bus can leave the stop.' } },
      { id: 'opt_2', text: { et: 'Kiirendab, et bussist mööda lipsata.', ru: 'Ускоряется, чтобы проскочить перед автобусом.', en: 'Speeds up to slip past the bus.' } },
