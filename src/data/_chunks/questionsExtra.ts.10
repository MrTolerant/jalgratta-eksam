    question: {
      et: 'Kuidas peab olema kinnitatud veos rattal?',
      ru: 'Как должен быть закреплён груз на велосипеде?',
      en: 'How must cargo be secured on a bicycle?',
    },
    options: [
      { id: 'opt_1', text: { et: 'Nii, et see ei takista juhtimist, ei ulatu ohtlikult välja ega varja tulesid.', ru: 'Так, чтобы не мешать управлению, не торчать опасно и не закрывать фонари.', en: 'So it does not hinder steering, stick out dangerously, or hide the lights.' } },
      { id: 'opt_2', text: { et: 'Kuidas iganes, peaasi et mahub.', ru: 'Как угодно, лишь бы влезло.', en: 'Any way, as long as it fits.' } },
      { id: 'opt_3', text: { et: 'Ainult ühe käega hoidev kott on parim.', ru: 'Лучше всего пакет в одной руке.', en: 'A bag held in one hand is best.' } },
    ],
    correctAnswerId: 'opt_1',
    explanation: {
      et: 'Veos ei tohi muuta ratast ebastabiilseks ega varjata tulesid/helkureid. Ühe käega sõitmine on ohtlik.',
      ru: 'Груз не должен делать велосипед неустойчивым и закрывать фары/катафоты. Езда одной рукой опасна.',
      en: 'Cargo must not make the bike unstable or hide lights/reflectors. One-handed riding is unsafe.',
    },
    lawReference: 'LS § 34',
  }),
